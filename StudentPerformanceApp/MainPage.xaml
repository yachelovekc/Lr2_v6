<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentPerformanceApp.MainPage"
             Title="Лабораторна робота №2 — Варіант 6: ІС «Успішність студентів»"
             BackgroundColor="#F3F4F6">

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="Файл">
            <MenuFlyoutItem Text="Відкрити XML-файл..." Clicked="OnSelectXmlClicked" />
            <MenuFlyoutItem Text="Відкрити XSL-шаблон..." Clicked="OnSelectXslClicked" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Вихід" Clicked="OnExitClicked" />
        </MenuBarItem>
        <MenuBarItem Text="Обробка">
            <MenuFlyoutItem Text="Виконати пошук (Аналіз)" Clicked="OnSearchClicked" />
            <MenuFlyoutItem Text="Трансформувати в HTML" Clicked="OnTransformClicked" />
            <MenuFlyoutItem Text="Очистити (Clear)" Clicked="OnClearClicked" />
        </MenuBarItem>
        <MenuBarItem Text="Довідка">
            <MenuFlyoutItem Text="Допомога користувачу" Clicked="OnHelpClicked" />
            <MenuFlyoutItem Text="Про програму" Clicked="OnAboutClicked" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="14" RowSpacing="12">

        <!-- Панель інструментів (кнопки, що дублюють головне меню) -->
        <Border Grid.Row="0" Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12" StrokeShape="RoundRectangle 8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <HorizontalStackLayout Grid.Row="0" Spacing="8">
                    <Button Text="📂 Обрати XML" Clicked="OnSelectXmlClicked" BackgroundColor="#1E3A8A" TextColor="White" />
                    <Button Text="🎨 Обрати XSL" Clicked="OnSelectXslClicked" BackgroundColor="#374151" TextColor="White" />
                    <Button Text="🔍 Пошук (Аналіз)" Clicked="OnSearchClicked" BackgroundColor="#2563EB" TextColor="White" FontAttributes="Bold" />
                    <Button Text="🌐 Трансформація в HTML" Clicked="OnTransformClicked" BackgroundColor="#059669" TextColor="White" FontAttributes="Bold" />
                    <Button Text="🧹 Clear (Очистити)" Clicked="OnClearClicked" BackgroundColor="#D97706" TextColor="White" FontAttributes="Bold" />
                    <Button Text="❓ Допомога" Clicked="OnHelpClicked" BackgroundColor="#4B5563" TextColor="White" />
                    <Button Text="ℹ️ Про програму" Clicked="OnAboutClicked" BackgroundColor="#4B5563" TextColor="White" />
                    <Button Text="🚪 Вихід" Clicked="OnExitClicked" BackgroundColor="#DC2626" TextColor="White" />
                </HorizontalStackLayout>

                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Entry x:Name="XmlPathLabel" Grid.Column="0" Text="XML: не обрано" IsReadOnly="True" FontSize="12" TextColor="#374151" BackgroundColor="Transparent" />
                    <Entry x:Name="XslPathLabel" Grid.Column="1" Text="XSL: не обрано" IsReadOnly="True" FontSize="12" TextColor="#374151" BackgroundColor="Transparent" />
                </Grid>
            </Grid>
        </Border>

        <!-- Основна робоча область: зліва параметри фільтрації та стратегії, справа поле виводу та HTML перегляд -->
        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="14">

            <!-- Ліва колонка: вибір стратегії та динамічні параметри пошуку -->
            <Border Grid.Column="0" Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="14" StrokeShape="RoundRectangle 8">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Метод аналізу (Шаблон Strategy)" FontAttributes="Bold" FontSize="15" TextColor="#1E3A8A" />
                        <VerticalStackLayout Spacing="4">
                            <RadioButton x:Name="SaxRadio" Content="1) SAX API (XmlReader)" GroupName="StrategyGroup" Value="SAX" CheckedChanged="OnStrategyChanged" TextColor="#111827" />
                            <RadioButton x:Name="DomRadio" Content="2) DOM API (XmlDocument + XPath)" GroupName="StrategyGroup" Value="DOM" CheckedChanged="OnStrategyChanged" TextColor="#111827" />
                            <RadioButton x:Name="LinqRadio" Content="3) LINQ to XML (XDocument)" GroupName="StrategyGroup" Value="LINQ" IsChecked="True" CheckedChanged="OnStrategyChanged" TextColor="#111827" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,4" />

                        <Label Text="Параметри пошуку (підвантажені з XML)" FontAttributes="Bold" FontSize="15" TextColor="#1E3A8A" />

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Ключове слово (П.І.П., дисципліна, викладач):" FontSize="12" TextColor="#374151" />
                            <Entry x:Name="KeywordEntry" Placeholder="Введіть текст для пошуку..." TextColor="#111827" PlaceholderColor="#9CA3AF" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Факультет / Інститут (@Faculty):" FontSize="12" TextColor="#374151" />
                            <Picker x:Name="FacultyPicker" Title="-- Усі факультети --" TextColor="#111827" TitleColor="#6B7280" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Кафедра (@Department):" FontSize="12" TextColor="#374151" />
                            <Picker x:Name="DepartmentPicker" Title="-- Усі кафедри --" TextColor="#111827" TitleColor="#6B7280" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Курс (@Course):" FontSize="12" TextColor="#374151" />
                                <Picker x:Name="CoursePicker" Title="-- Усі --" TextColor="#111827" TitleColor="#6B7280" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Група (@Group):" FontSize="12" TextColor="#374151" />
                                <Picker x:Name="GroupPicker" Title="-- Усі --" TextColor="#111827" TitleColor="#6B7280" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Форма (@StudyForm):" FontSize="12" TextColor="#374151" />
                                <Picker x:Name="StudyFormPicker" Title="-- Усі --" TextColor="#111827" TitleColor="#6B7280" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Стипендія (@Scholarship):" FontSize="12" TextColor="#374151" />
                                <Picker x:Name="ScholarshipPicker" Title="-- Усі --" TextColor="#111827" TitleColor="#6B7280" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Навчальна дисципліна (Discipline/@Name):" FontSize="12" TextColor="#374151" />
                            <Picker x:Name="DisciplinePicker" Title="-- Усі дисципліни --" TextColor="#111827" TitleColor="#6B7280" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Оцінка (@NationalGrade):" FontSize="12" TextColor="#374151" />
                                <Picker x:Name="NationalGradePicker" Title="-- Усі --" TextColor="#111827" TitleColor="#6B7280" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Мін. бал (0-100):" FontSize="12" TextColor="#374151" />
                                <Entry x:Name="MinGradeEntry" Placeholder="напр. 90" Keyboard="Numeric" TextColor="#111827" PlaceholderColor="#9CA3AF" />
                            </VerticalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                            <CheckBox x:Name="TransformFilteredCheckBox" IsChecked="False" Color="#2563EB" />
                            <Label Text="Трансформувати лише знайдену вибірку" VerticalOptions="Center" FontSize="12" TextColor="#374151" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- Права колонка: результати пошуку (текстовий вивід) та перегляд згенерованого HTML -->
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="12">
                <Border Grid.Row="0" Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12" StrokeShape="RoundRectangle 8">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                        <Label Grid.Row="0" Text="Поле виводу результатів аналізу XML:" FontAttributes="Bold" FontSize="14" TextColor="#1E3A8A" />
                        <Editor x:Name="OutputEditor"
                                Grid.Row="1"
                                IsReadOnly="True"
                                FontFamily="Consolas"
                                FontSize="13"
                                TextColor="#111827"
                                BackgroundColor="#F9FAFB"
                                Placeholder="Тут відображатимуться результати пошуку (SAX, DOM або LINQ to XML)..." />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12" StrokeShape="RoundRectangle 8">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                        <Label Grid.Row="0" Text="Попередній перегляд XSLT-трансформації у файл HTML:" FontAttributes="Bold" FontSize="14" TextColor="#059669" />
                        <WebView x:Name="HtmlPreviewWebView" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Рядок стану (Entry у режимі ReadOnly дозволяє виділяти та копіювати шлях Ctrl+C) -->
        <Border Grid.Row="2" Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="#1E3A8A" Padding="8,2" StrokeShape="RoundRectangle 6">
            <Entry x:Name="StatusLabel"
                   Text="Готово. Підвантажено демонстраційний XML-файл варіанту №6 («Успішність студентів»)."
                   IsReadOnly="True"
                   TextColor="White"
                   BackgroundColor="Transparent"
                   FontSize="12" />
        </Border>
    </Grid>
</ContentPage>
